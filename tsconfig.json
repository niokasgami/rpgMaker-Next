{
  "compilerOptions": {
    "target": "es2020",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "outDir": "game/js",
    "strictNullChecks": false,
    "allowImportingTsExtensions": true,
    "noImplicitOverride": true,
    "baseUrl": ".",
    "paths": {
      "rmmz/*": ["src/*"],

      "@core" : [ "src/core"],
      "@core/*": ["src/core/*"],

      "@data" : [ "src/data"],
      "@data/*": ["src/data/*"],

      "@managers" : ["src/managers"],
      "@managers/*": ["src/managers/*"],

      "@objects" : ["src/objects"],
      "@objects/*": ["src/objects/*"],

      "@scenes": ["src/scenes"],
      "@scenes/*": ["src/scenes/*"]
    }
  },
  "include": ["src", "libs/**/*.d.ts", "main.ts", "test/src/**/*.ts"]
}
